---
import Base from '../layouts/Base.astro';
import Picto from '../components/Picto.astro';
import AfterLinks from '../components/AfterLinks.astro';
import { ui } from '../i18n/en';
import { getChecklist } from '../lib/checklist';
import { url } from '../lib/site';

const list = getChecklist(ui.lang);
---

<Base>
  <div class="wrap home">
    <div class="hero">
      <section class="start" aria-labelledby="start-title">
        <h1 id="start-title" class="display">{list.title}</h1>
        <a class="btn go" href={url('/checklist/')}>
          {ui.start}
          <Picto name="arrow" />
        </a>
      </section>
    </div>

    <div class="after">
      <AfterLinks />
    </div>
  </div>
</Base>

<style>
  /* The start card takes the free space and sits centred in it; footer stays on screen. */
  .home {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .hero {
    flex: 1;
    display: grid;
    align-content: center;
    padding-block: var(--space-5);
  }
  .start {
    padding: var(--space-5);
    border: var(--border-hard) solid var(--black);
    background: var(--tape);
    color: var(--on-tape);
    box-shadow: var(--shadow-hard);
    font-size: 20px;
    line-height: 28px;
    font-weight: 700;
  }
  /* The one action on the page: black on tape, full width, primary height. */
  .go {
    width: 100%;
    min-height: var(--tap-primary);
    margin-block-start: var(--space-5);
    justify-content: space-between;
    border-color: var(--black);
    background: var(--black);
    color: var(--white);
    box-shadow: none;
  }
  :root[data-theme] .go:focus-visible {
    outline-color: var(--black);
  }

  .after {
    margin-block-start: var(--space-3);
  }
</style>
