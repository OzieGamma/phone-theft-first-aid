---
import Base from '../layouts/Base.astro';
import Links from '../components/Links.astro';
import Expander from '../components/Expander.astro';
import Notice from '../components/Notice.astro';
import { countries } from '../lib/sources';
import { repo } from '../lib/site';
---

<Base title="Data sources" description="Official stolen-phone guides by country: government, police, regulators, consumer groups, operators and phone makers.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="display">Data sources</h1>
      <p>Official advice in each country. Rules are different in every country. Some guides are only in the local language</p>
    </header>

    <div class="warning">
      <Notice tone="warn" title="This list was compiled with AI. No person has checked it yet">
        <p>Links can be wrong or out of date. Check each page before you rely on it</p>
        <p><a href={repo}>Report a mistake</a></p>
      </Notice>
    </div>

    {
      countries.map((group) => (
        <Expander title={group.country}>
          <Links links={group.links} />
        </Expander>
      ))
    }
  </div>
</Base>


<style>
  .warning {
    margin-block-end: var(--space-6);
  }
</style>
