---
import Base from '../layouts/Base.astro';
---

<Base title="Privacy" description="What this site keeps about you, and where.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="display">Privacy</h1>
    </header>

    <div class="stack body">
      <p>This site is plain files. There is no server of mine that stores anything you do here</p>
      <p>
        Your checklist progress stays in this browser tab. It is deleted when you close the tab, so nothing is left on a
        borrowed phone or computer
      </p>
      <p>The fonts are served from this site. I load nothing from other companies</p>
      <p>The company that hosts these files may keep standard access logs, like any website</p>
    </div>
  </div>
</Base>

<style>
  .body {
    font-size: 18px;
    line-height: 29px;
  }
</style>
