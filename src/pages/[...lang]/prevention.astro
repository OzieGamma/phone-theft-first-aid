---
import Base from '../../layouts/Base.astro';
import TodoList from '../../components/TodoList.astro';
import { langPaths, t, type Lang } from '../../i18n';
import thefts from '../../data/london-thefts.json';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const page = t(lang).prevention;

const number = (n: number) => n.toLocaleString(t(lang).locale);
const date = (iso: string) =>
  new Date(iso).toLocaleDateString(t(lang).locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const lastFull = thefts.years.at(-1)!;
const minutes = Math.round((365 * 24 * 60) / lastFull.value);

// Line chart, drawn at build time as inline SVG: no script, no third-party request.
const chart = { width: 320, height: 220, left: 24, right: 296, top: 34, bottom: 180 };
const step = 20000;
const top = Math.ceil(Math.max(...thefts.years.map((row) => row.value)) / step) * step;
const ticks = Array.from({ length: top / step + 1 }, (_, i) => i * step);
const x = (i: number) => chart.left + (i * (chart.right - chart.left)) / (thefts.years.length - 1);
const y = (value: number) => chart.bottom - (value / top) * (chart.bottom - chart.top);
const points = thefts.years.map((row, i) => ({ ...row, x: x(i), y: y(row.value) }));
const peak = points.reduce((a, b) => (b.value > a.value ? b : a));
// Label only the first, lowest, highest and latest years, not every point.
const labelled = new Set([points[0], points.reduce((a, b) => (b.value < a.value ? b : a)), peak, points.at(-1)!]);

---

<Base lang={lang} title={page.title} description={page.description}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="display">{page.title}</h1>
      <p>{page.lead}</p>
    </header>

    <section class="context" aria-labelledby="context-title">
      <p class="hero"><strong>{number(lastFull.value)}</strong></p>
      <h2 id="context-title">{page.chartTitle(lastFull.year)}</h2>
      <p>{page.every(minutes)}</p>

      <figure class="chart">
        <figcaption>{page.measure}</figcaption>
        <svg viewBox={`0 0 ${chart.width} ${chart.height}`} role="img" aria-labelledby="chart-desc">
          <desc id="chart-desc">
            {points.map((point) => `${point.year}: ${number(point.value)}`).join(', ')}
          </desc>
          {
            ticks.map((tick) => (
              <line class:list={['grid', { base: tick === 0 }]} x1={0} x2={chart.width} y1={y(tick)} y2={y(tick)} />
            ))
          }
          <polyline class="line" points={points.map((point) => `${point.x},${point.y}`).join(' ')} />
          {
            points.map((point, i) => (
              <g class="point">
                <title>{`${point.year}: ${number(point.value)}`}</title>
                <circle cx={point.x} cy={point.y} r="5" />
                {labelled.has(point) && (
                  <text
                    class="value"
                    x={point.x}
                    y={point.y + (point === peak || i === 0 ? -12 : 24)}
                    text-anchor={i === 0 ? 'start' : i === points.length - 1 ? 'end' : 'middle'}
                    dx={i === 0 ? -10 : i === points.length - 1 ? 10 : 0}
                  >
                    {number(point.value)}
                  </text>
                )}
                <text class="year" x={point.x} y={chart.height - 14} text-anchor="middle">
                  {point.year}
                </text>
              </g>
            ))
          }
        </svg>
      </figure>

      <p class="source">
        {page.updated} <time datetime={thefts.updated}>{date(thefts.updated)}</time> · <a href={thefts.source.href}>{page.source}</a>
      </p>
    </section>

    <div class="warning">
      <p class="warning-kicker">{page.warningKicker}</p>
      <p class="warning-text">{page.warningText}</p>
      <p class="warning-stat">
        <strong>44%</strong>
        {page.warningStat}
      </p>
      <p class="warning-source">
        <a
          href="https://www.prnewswire.com/news-releases/more-than-5-5-million-adults-in-the-uk-fell-victim-to-identity-fraud-in-the-last-12-months-301496787.html"
          title={page.warningSourceNote}>{page.warningSource}</a
        >
      </p>
    </div>

    <h2 class="list-title">{page.listTitle}</h2>
    <TodoList lang={lang} items={page.items} storageKey="ptfa-prevention" />
  </div>
</Base>

<style>
  .context {
    margin-block-end: var(--space-8);
    font-size: 18px;
    line-height: 29px;
  }
  .hero {
    font-family: var(--font-condensed);
    font-stretch: 75%;
    font-size: 80px;
    line-height: 72px;
    font-weight: 900;
    color: var(--tape);
    font-variant-numeric: tabular-nums;
  }
  .context h2 {
    margin-block-start: var(--space-2);
    font-size: 22px;
    line-height: 30px;
    font-weight: 800;
  }
  .chart {
    margin: var(--space-6) 0 0;
  }
  .chart figcaption {
    margin-block-end: var(--space-2);
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 24px;
  }
  .chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grid {
    stroke: var(--line);
    stroke-width: 1;
  }
  .grid.base {
    stroke: var(--line-strong);
  }
  .chart text {
    fill: var(--ink-muted);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .line {
    fill: none;
    stroke: var(--tape);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .point circle {
    fill: var(--tape);
    stroke: var(--paper);
    stroke-width: 2;
  }
  .chart .value {
    fill: var(--ink);
    font-size: 14px;
    font-weight: 700;
  }
  .warning {
    margin-block-end: var(--space-8);
    padding: var(--space-6) var(--space-5);
    background: var(--tape);
    color: var(--on-tape);
    font-family: var(--font-condensed);
    font-stretch: 75%;
    font-size: 48px;
    line-height: 48px;
    font-weight: 900;
    text-transform: uppercase;
  }
  .warning-kicker {
    margin-block-end: var(--space-3);
    font-size: 20px;
    line-height: 24px;
    font-weight: 800;
  }
  .warning-stat {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hard) solid var(--on-tape);
    font-family: var(--font-sans);
    font-stretch: 100%;
    font-size: 20px;
    line-height: 28px;
    font-weight: 700;
    text-transform: none;
  }
  .warning-stat strong {
    display: block;
    font-family: var(--font-condensed);
    font-stretch: 75%;
    font-size: 80px;
    line-height: 72px;
    font-weight: 900;
  }
  .warning-source {
    margin-block-start: var(--space-3);
    font-family: var(--font-sans);
    font-stretch: 100%;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    text-transform: none;
  }
  .warning-source a {
    color: var(--on-tape);
    text-decoration: underline dotted 2px;
    text-underline-offset: 4px;
    cursor: help;
  }
  .source {
    margin-block-start: var(--space-4);
    color: var(--ink-muted);
    font-size: 16px;
    line-height: 24px;
  }
  .source a {
    color: var(--ink);
  }
  .list-title {
    font-size: 22px;
    line-height: 30px;
    font-weight: 800;
  }
</style>
