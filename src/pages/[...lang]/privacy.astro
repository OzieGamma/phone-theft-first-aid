---
import Base from '../../layouts/Base.astro';
import { langPaths, t, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const page = ui.privacy;
---

<Base lang={lang} title={page.title} description={page.description}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="display">{page.title}</h1>
    </header>

    <div class="stack body">
      {page.lines.map((line) => <p>{line}</p>)}
    </div>
  </div>
</Base>

<style>
  .body {
    font-size: 18px;
    line-height: 29px;
  }
</style>
