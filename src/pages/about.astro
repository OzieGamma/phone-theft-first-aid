---
import Base from '../layouts/Base.astro';
import { author, repo } from '../lib/site';
---

<Base title="About" description="Made by someone whose phone was stolen.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="display">About</h1>
    </header>

    <div class="stack body">
      <p>
        My phone was stolen. I didn't have another device, I was locked out of my accounts by security features such as double authentication. By the time I managed to get back in, thieves had done monstruous damage.
        This website is an attempt to list wht I should have done in advance to limit damage, right after the incident, and to recover as much as possible.
      </p>
      <p>I am not a security company or an agency. The information on this website is not meant to be exhaustive.</p>
      <p>Vibe-coded by <a href={repo}>{author}</a>. Found a mistake or a better step? <a href={repo}>Contribute</a></p>
      <p>
        Press, operators, phone makers, anyone who wants stolen phones to be worth nothing: write to
        <a class="email" data-user="ycacovda" data-domain="gro.dia-tsrif-tfeht-enohp">advocacy at phone-theft-first-aid dot org</a>
      </p>
    </div>
  </div>
</Base>

<script>
  // The address is stored reversed and assembled here, so simple scrapers reading the HTML do not find it.
  // Without JavaScript the spelled-out text stays.
  const reverse = (text: string) => [...text].reverse().join('');
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a.email')) {
    const address = `${reverse(link.dataset.user!)}@${reverse(link.dataset.domain!)}`;
    link.href = `mailto:${address}`;
    link.textContent = address;
  }
</script>

<style>
  .body {
    font-size: 18px;
    line-height: 29px;
  }
</style>
