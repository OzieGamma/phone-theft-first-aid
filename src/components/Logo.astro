---
// Live logo: the mark from brandkit/assets/Logos/mark.svg plus the name set as text,
// so it follows the theme and stays sharp. The name is always English, in full.
import Mark from './Mark.astro';
import { url } from '../lib/site';
---

<a class="logo" href={url('/')} lang="en" dir="ltr">
  <Mark class="mark" />
  <span class="name">Phone Theft<br />First Aid</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-min);
    color: var(--ink);
    text-decoration: none;
  }
  .logo :global(.mark) {
    width: 44px;
    height: 44px;
    flex: none;
  }
  .name {
    font-family: var(--font-condensed);
    font-stretch: 75%;
    font-weight: 900;
    font-size: 20px;
    line-height: 19px;
    text-transform: uppercase;
  }
</style>
