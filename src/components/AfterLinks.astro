---
// Layers 2 and 3, linked after the checklist. Pass items to link a single next page
// at the bottom of another page, without the heading.
import Picto from './Picto.astro';
import { home } from '../i18n/en';
import { url } from '../lib/site';

interface Props {
  items?: typeof home.next;
}

const { items } = Astro.props;
---

<section class="after" aria-labelledby={items ? undefined : 'after-title'}>
  {!items && <h2 id="after-title" class="title">{home.nextTitle}</h2>}
  <ul>
    {
      (items ?? home.next).map((item) => (
        <li>
          <a href={url(item.href)}>
            <Picto name={item.picto} size="lg" />
            <span>
              <strong>{item.title}</strong>
              <span>{item.text}</span>
            </span>
            <Picto name="arrow" />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .after ul {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .after a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-primary);
    padding: var(--space-4);
    border: 2px solid var(--line-strong);
    background: var(--surface-raised);
    text-decoration: none;
  }
  .after a > span {
    flex: 1;
  }
  .after strong {
    display: block;
    font-size: 20px;
    line-height: 26px;
  }
  .after strong + span {
    color: var(--ink-muted);
  }
</style>
