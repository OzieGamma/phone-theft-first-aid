---
// Inline SVG pictograms from brandkit/assets/Pictograms, drawn in currentColor.
// Decorative by default; pass `label` when the pictogram stands alone.
export type PictoName =
  | 'lock' | 'locate' | 'wipe' | 'sim-block' | 'password' | 'card'
  | 'police-report' | 'insurance' | 'imei' | 'backup' | 'borrowed-device' | 'language'
  | 'check' | 'arrow' | 'alert' | 'info';

interface Props {
  name: PictoName;
  size?: 'sm' | 'lg';
  label?: string;
}

const files = import.meta.glob<string>('../../brandkit/assets/Pictograms/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const { name, size = 'sm', label } = Astro.props;
const file = Object.entries(files).find(([path]) => path.endsWith(`/${name}.svg`));
if (!file) throw new Error(`Unknown pictogram: ${name}`);

const inner = file[1]
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>[\s\S]*$/, '')
  .replace(/fill="#[0-9A-Fa-f]{3,6}"/g, 'fill="currentColor"');
---

<svg
  class:list={['picto', `picto-${size}`, { mirror: name === 'arrow' }]}
  viewBox="0 0 24 24"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
/>

<style>
  .picto {
    flex: none;
    fill: currentColor;
  }
  .picto-sm {
    width: var(--picto-sm);
    height: var(--picto-sm);
  }
  .picto-lg {
    width: var(--picto-lg);
    height: var(--picto-lg);
  }
  :global([dir='rtl']) .mirror {
    transform: scaleX(-1);
  }
</style>
